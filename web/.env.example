# Copy to .env and fill in. Never commit .env.

# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# true = use local Firebase emulators (firebase emulators:start)
VITE_USE_EMULATORS=false

# Mapbox public token (pk.*). Restrict it by URL in your Mapbox account.
VITE_MAPBOX_TOKEN=

# OpenRouteService key — only used as fallback when every Mapbox route crosses a flood zone
VITE_ORS_KEY=
