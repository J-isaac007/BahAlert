# For scripts/seed.mjs, simulate.mjs and make-admin.mjs. Copy to .env (repo root).

# Your RTDB URL, e.g. https://floodwatch-lite-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_DATABASE_URL=

# Option A — real Firebase: service account key (Firebase console > Project settings > Service accounts)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# Alert service (node service/index.mjs)
# SMS Gateway for Android > Cloud server: username and password shown in the app. Empty = dry run (logs only).
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=
# Optional: local mode instead of cloud, e.g. http://192.168.1.20:8080/message
# SMS_GATEWAY_URL=
# Telegram bot token from @BotFather. Empty = bot off.
TELEGRAM_BOT_TOKEN=
# Optional: chat ids that always get alerts (team / barangay group), comma-separated
TELEGRAM_ALERT_CHAT_IDS=
# Optional: serve the prototype ESP32 endpoints from this service instead of firmware/team-server.
# Leave empty when the team's server runs (it uses port 3000).
BRIDGE_PORT=
BRIDGE_DEVICE_ID=bah-001
# Links in messages
PUBLIC_SITE_URL=https://j-isaac007.github.io/BahAlert

# Option B — local emulator (firebase emulators:start). Uncomment; no key needed.
# FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
# FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=floodwatch-993ef-default-rtdb
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
