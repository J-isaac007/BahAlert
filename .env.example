# For scripts/seed.mjs, simulate.mjs and make-admin.mjs. Copy to .env (repo root).

# Your RTDB URL, e.g. https://floodwatch-lite-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_DATABASE_URL=

# Option A — real Firebase: service account key (Firebase console > Project settings > Service accounts)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# Option B — local emulator (firebase emulators:start). Uncomment; no key needed.
# FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
# FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=floodwatch-lite-default-rtdb
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
