{
  "rules": {
    "devices": {
      ".read": true,
      "$deviceId": {
        "meta": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
        },
        "config": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
        },
        "live": {
          ".write": "auth != null && root.child('deviceAuth').child($deviceId).val() === auth.uid",
          ".validate": "newData.hasChildren(['levelCm', 'distanceCm', 'status', 'ts']) && newData.child('status').val().matches(/^(green|yellow|red)$/)"
        }
      }
    },
    "readings": {
      ".read": true,
      "$deviceId": {
        ".indexOn": ["ts"],
        ".write": "auth != null && root.child('deviceAuth').child($deviceId).val() === auth.uid"
      }
    },
    "alerts": {
      ".read": true,
      "$deviceId": {
        ".indexOn": ["ts"],
        ".write": "auth != null && (root.child('deviceAuth').child($deviceId).val() === auth.uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "stats": {
      ".read": true,
      "$deviceId": {
        ".write": "auth != null && root.child('deviceAuth').child($deviceId).val() === auth.uid"
      }
    },
    "safeZones": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "hotlines": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && $uid !== auth.uid",
        ".validate": "newData.val() === true"
      }
    },
    "adminProfiles": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && $uid !== auth.uid",
        ".validate": "newData.hasChildren(['email', 'addedAt']) && newData.child('email').isString()"
      }
    },
    "deviceAuth": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "residents": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["telegramChatId"],
      "$rid": {
        ".read": "auth != null && auth.uid === $rid",
        ".write": "auth != null && auth.uid === $rid && !newData.exists()",
        "name": {
          ".write": "auth != null && auth.uid === $rid",
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
        },
        "barangay": {
          ".write": "auth != null && auth.uid === $rid",
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "watch": {
          ".write": "auth != null && auth.uid === $rid",
          "$deviceId": {
            ".validate": "newData.val() === true && root.child('devices').child($deviceId).exists()"
          }
        },
        "channels": {
          ".write": "auth != null && auth.uid === $rid",
          ".validate": "newData.hasChildren(['sms', 'telegram'])",
          "sms": { ".validate": "newData.isBoolean()" },
          "telegram": {
            ".validate": "newData.isBoolean() && (newData.val() === false || newData.parent().parent().child('telegramChatId').exists())"
          },
          "$other": { ".validate": false }
        },
        "phone": {},
        "telegramChatId": {},
        "createdAt": {},
        "$other": { ".validate": false }
      }
    },
    "otpRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !newData.exists()",
        "phone": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().matches(/^\\+639[0-9]{9}$/)"
        },
        "requestedAt": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === now"
        },
        "code": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{6}$/)"
        },
        "$other": { ".validate": false }
      }
    },
    "telegramLinks": {
      "$code": {
        ".write": "auth != null && !data.exists() && root.child('residents').child(auth.uid).exists()",
        ".validate": "$code.matches(/^[A-Za-z0-9_-]{16,40}$/) && newData.hasChildren(['rid', 'ts']) && newData.child('rid').val() === auth.uid && newData.child('ts').val() === now"
      }
    }
  }
}
